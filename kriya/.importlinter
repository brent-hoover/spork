# Declared module boundaries (avspec.yaml modules[].boundaries.may_import)
# enforced against real imports by the stack's arch command:
#   uv run lint-imports
# One package per module; each forbidden contract lists every kriya module
# the source may NOT import — the complement of its declared may_import.
# Modules with an empty may_import forbid all other domain modules.

[importlinter]
root_package = kriya

[importlinter:contract:planner]
name = planner imports only tracker-client
type = forbidden
source_modules = kriya.planner
forbidden_modules =
    kriya.orchestrator
    kriya.workspace
    kriya.dev_loop
    kriya.review_bridge
    kriya.gates
    kriya.architect
    kriya.owner
    kriya.context
    kriya.cli
    kriya.tui

[importlinter:contract:orchestrator]
name = orchestrator imports planner, workspace, dev-loop, gates, owner, tracker-client
type = forbidden
source_modules = kriya.orchestrator
forbidden_modules =
    kriya.review_bridge
    kriya.architect
    kriya.context
    kriya.cli
    kriya.tui

[importlinter:contract:workspace]
name = workspace imports nothing
type = forbidden
source_modules = kriya.workspace
forbidden_modules =
    kriya.planner
    kriya.orchestrator
    kriya.dev_loop
    kriya.review_bridge
    kriya.gates
    kriya.architect
    kriya.owner
    kriya.context
    kriya.tracker_client
    kriya.cli
    kriya.tui

